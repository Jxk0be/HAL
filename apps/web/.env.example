# Web app env (Vite exposes only VITE_* to the browser). Copy to apps/web/.env.local.
# Everything here is public by design; never put secrets in a VITE_ variable.

# Supabase API URL for the BIL project.
VITE_SUPABASE_URL=https://lluwzpwiybvgnsimpwey.supabase.co
# Supabase publishable key (Project Settings > API Keys). Safe for the browser; RLS protects data.
VITE_SUPABASE_PUBLISHABLE_KEY=
# BIL Discord server invite (set to never expire in Discord).
VITE_DISCORD_INVITE_URL=https://discord.gg/WWavSTQXWR
# Link to the #lf-8s channel for the /8s page's "Join in Discord" button (right-click the channel →
# Copy Link). Optional: falls back to the invite.
VITE_DISCORD_EIGHTS_URL=
# Public site URL (no trailing slash). Used for absolute Open Graph image links. Set on Netlify.
VITE_SITE_URL=
