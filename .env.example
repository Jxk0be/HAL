# Root env: used by scripts/ and the Supabase CLI. Copy to .env and fill in. Never commit .env.

# Supabase project ref (Blackhat Invitational League).
SUPABASE_PROJECT_REF=lluwzpwiybvgnsimpwey
# Service role key (Supabase dashboard > Project Settings > API). Server/scripts only. NEVER ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Discord application (Developer Portal > BIL).
DISCORD_APP_ID=
# General Information > Public Key. Used to verify interaction signatures in the Edge Function.
DISCORD_PUBLIC_KEY=
# Bot > Token. Used by scripts/ to register slash commands and by Edge Functions for REST calls.
DISCORD_BOT_TOKEN=
# Server (guild) ID of the BIL Discord server. Developer Mode > right-click server > Copy Server ID.
DISCORD_GUILD_ID=
